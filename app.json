{
  "expo": {
    "name": "triviaHub",
    "slug": "triviaHub",
    "scheme": [
      "myapp"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/msh.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.harryd.triviahub",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/msh.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90ccd879-ea5b-445c-83ce-127310d5f36d"
      }
    },
    "owner": "harryd"
  }
}
